{
  "name": "the-sabian-story",
  "version": "0.1.0",
  "private": true,
  "description": "The Sabian Story — a contemplative astrology experience centered on the 360 Sabian Symbols. Testing-phase MVP.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "validate:symbols": "tsx scripts/validate-symbols.ts",
    "cleanup:readings": "tsx scripts/cleanup-readings.ts",
    "e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run validate:symbols && npm run build"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.0.0",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/source-sans-3": "^5.0.0",
    "astronomy-engine": "^2.1.19",
    "lucide-react": "^1.33.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  }
}
