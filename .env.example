# ------------------------------------------------------------------
# The Sabian Story — environment template
# Copy to `.env.local` and fill in the values you have. Never commit
# real credentials. All values below are safe placeholders; the app
# runs fully in deterministic demo mode with none of them set.
# ------------------------------------------------------------------

# --- Runtime -------------------------------------------------------
# Required by Next.js.
NODE_ENV=development

# --- App behavior --------------------------------------------------
# Must be "false" until a real payment provider is integrated.
MONETIZATION_ENABLED=false

# Absolute path to a 360-record Sabian symbol dataset.
# Leave unset to use the 120-record demo fixture. The file is read at runtime
# and validated at startup; it is never bundled into the build.
#
# The committed datasets/original-sabian-symbols.json is an original,
# project-generated 360-record dataset marked public-domain-original.
# Replace it with a licensed dataset if you want the historical Sabian wording.
SABIAN_DATASET_PATH=datasets/original-sabian-symbols.json

# Number of trusted proxy hops on the right side of X-Forwarded-For.
#
# On Vercel you do NOT need this: the platform sets x-vercel-forwarded-for,
# which it strips from client input, and that is used automatically.
#
# Set it ONLY when self-hosting behind your own reverse proxy, to the number of
# proxies you control. cf-connecting-ip and x-real-ip are never trusted: any
# client can send them, so trusting one lets an attacker bypass rate limiting
# by varying the header. Otherwise
# X-Forwarded-For is ignored for rate limiting because it is attacker-controlled.
# TRUSTED_PROXY_HOPS=1

# In testing mode every feature is unlocked regardless of entitlement.
# Set to "false" to start enforcing feature flags.
TESTING_MODE_ENABLED=true

# --- Database ------------------------------------------------------
# Local SQLite file path (relative to project root).
DATABASE_URL=file:./data/sabian.db
# PostgreSQL runtime is implemented but requires a provisioned schema and a
# controlled live verification before production use:
# DATABASE_URL=postgres://user:pass@host:5432/sabian?sslmode=require
POSTGRES_POOL_MAX=10
POSTGRES_CONNECTION_TIMEOUT_MS=5000

# Retention policy for saved readings (days). Readings older than this
# are removed by `npm run cleanup:readings`.
READING_RETENTION_DAYS=90

# --- Geocoding (PlaceSearchProvider) -------------------------------
# Optional. When unset, the deterministic local place index is used.
# GEOCODING_API_URL=
# GEOCODING_API_KEY=
# Required (32+ random characters) with live geocoding in production. This
# signs canonical place results so browser-supplied coordinates are not trusted.
# PLACE_TOKEN_SECRET=

# --- AI text provider (InterpretationProvider) ---------------------
# Optional. When unset, the deterministic mock provider is used and
# output is clearly labeled as demo.
# TEXT_PROVIDER=anthropic|openai|mock
TEXT_PROVIDER=mock
# TEXT_API_KEY=
# TEXT_MODEL=

# --- Image provider (ImageGenerationProvider) ----------------------
# Optional. When unset, deterministic SVG placeholder art is used and
# labeled as demo artwork.
# IMAGE_PROVIDER=openai|replicate|mock
IMAGE_PROVIDER=mock
# IMAGE_API_KEY=
# IMAGE_MODEL=

# --- Optional telemetry-free observability -------------------------
# LOG_LEVEL=info
