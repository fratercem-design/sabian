# ------------------------------------------------------------------
# The Sabian Story — environment template
# Copy to `.env.local` and fill in the values you have. Never commit
# real credentials. All values below are safe placeholders; the app
# runs fully in deterministic demo mode with none of them set.
# ------------------------------------------------------------------

# --- Runtime -------------------------------------------------------
# Required by Next.js.
NODE_ENV=development

# --- App behavior --------------------------------------------------
# Must be "false" until a real payment provider is integrated.
MONETIZATION_ENABLED=false

# In testing mode every feature is unlocked regardless of entitlement.
# Set to "false" to start enforcing feature flags.
TESTING_MODE_ENABLED=true

# --- Database ------------------------------------------------------
# Local SQLite file path (relative to project root).
DATABASE_URL=file:./data/sabian.db
# Planned: DATABASE_URL=postgres://user:pass@host:5432/sabian

# Retention policy for saved readings (days). Readings older than this
# are removed by `npm run cleanup:readings`.
READING_RETENTION_DAYS=90

# --- Geocoding (PlaceSearchProvider) -------------------------------
# Optional. When unset, the deterministic local place index is used.
# GEOCODING_API_URL=
# GEOCODING_API_KEY=

# --- AI text provider (InterpretationProvider) ---------------------
# Optional. When unset, the deterministic mock provider is used and
# output is clearly labeled as demo.
# TEXT_PROVIDER=anthropic|openai|mock
TEXT_PROVIDER=mock
# TEXT_API_KEY=
# TEXT_MODEL=

# --- Image provider (ImageGenerationProvider) ----------------------
# Optional. When unset, deterministic SVG placeholder art is used and
# labeled as demo artwork.
# IMAGE_PROVIDER=openai|replicate|mock
IMAGE_PROVIDER=mock
# IMAGE_API_KEY=
# IMAGE_MODEL=

# --- Optional telemetry-free observability -------------------------
# LOG_LEVEL=info
